<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carcolate.agents.mapper.CopilotHistoryMapper">

    <select id="List" resultType="com.carcolate.agents.domain.CopilotHistory">
        SELECT h.* FROM tb_copilot_history AS h
        <where>
            <if test="p.id!=null">
                AND h.id = #{p.id}
            </if>
            <if test="p.uuid!=null and p.uuid!=''">
                AND h.uuid = #{p.uuid}
            </if>
            <if test="p.agentId!=null">
                AND h.agent_id = #{p.agentId}
            </if>
            <if test="p.status!=null and p.status!=''">
                AND h.status = #{p.status}
            </if>
            <if test="p.userMessage!=null and p.userMessage!=''">
                AND h.user_message LIKE CONCAT('%', #{p.userMessage}, '%')
            </if>
        </where>
        ORDER BY h.created_at DESC
    </select>

</mapper>
